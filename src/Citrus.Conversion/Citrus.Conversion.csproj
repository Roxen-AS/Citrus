<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Citrus.Core/Citrus.Core.csproj" />
    <PackageReference Include="Magick.NET-Q8-x64" Version="[15.0.0]" />
    <PackageReference Include="PDFsharp" Version="[6.2.4]" />
    <PackageReference Include="PDFtoImage" Version="[5.4.0]" />
    <PackageReference Include="PdfPig" Version="[0.1.16]" />
    <!-- Override PDFsharp's vulnerable minimum with the current .NET 10 security patch. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="[10.0.13]" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../packaging/pdf-backend.lock.json" Link="pdf-backend.lock.json" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../packaging/notices/PDF-Notice.txt" Link="notices/PDF-Notice.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../packaging/notices/pdf-licenses/**/*" Link="notices/pdf-licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/pdf-engine.md" Link="docs/pdf-engine.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../packaging/media/win-x64/*" Link="media/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../packaging/media/source/*" Link="source/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../packaging/media-lock.json" Link="media-lock.json" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../packaging/media/sha256.json" Link="media-sha256.json" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../packaging/notices/Media-Notice.txt" Link="notices/Media-Notice.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../packaging/notices/media-licenses/*" Link="notices/media-licenses/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/media-engine.md" Link="docs/media-engine.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireOfflineMediaForWindowsPublish" BeforeTargets="PrepareForPublish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Error Condition="!Exists('../../packaging/media/win-x64/ffmpeg.exe') Or !Exists('../../packaging/media/win-x64/ffprobe.exe') Or !Exists('../../packaging/media/source/citrus-media-source.tar.gz')" Text="Offline media assets or corresponding source archive are missing. Run packaging/build-media.sh before publishing." />
  </Target>
</Project>
