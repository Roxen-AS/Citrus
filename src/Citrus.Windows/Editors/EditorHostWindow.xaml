<Window x:Class="Citrus.Windows.Editors.EditorHostWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Citrus.Windows.Presentation" xmlns:e="clr-namespace:Citrus.Windows.Editors" xmlns:i="clr-namespace:Citrus.Windows.Editors.Image"
 Title="Image editor · Citrus" Width="1100" Height="760" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}" FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource BodySize}" TextBlock.LineHeight="{DynamicResource BodyLeading}">
 <p:MaterialSurface x:Name="Chrome"><Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto" MinHeight="72"/></Grid.RowDefinitions>
  <Grid Margin="4,0,4,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="Heading" FontSize="{DynamicResource EditorTitleSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{DynamicResource TertiaryButton}" Content="Undo" ToolTip="Undo · Ctrl+Z" Click="Undo"/><Button Style="{DynamicResource TertiaryButton}" Content="Redo" ToolTip="Redo · Ctrl+Y" Click="Redo"/><Button Style="{DynamicResource TertiaryButton}" Content="Reset" Click="Reset"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="220"/><ColumnDefinition Width="304"/></Grid.ColumnDefinitions>
   <Border Margin="0,0,12,0" Background="{DynamicResource MaterialContentSurface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Expander Margin="12,8" IsExpanded="False"><Expander.Header><TextBlock x:Name="SourceHeading" Text="Images" TextTrimming="CharacterEllipsis"/></Expander.Header><StackPanel>
     <ListBox x:Name="SourceList" MaxHeight="160" SelectionChanged="SelectSource" AutomationProperties.Name="Preview source; checkboxes control export inclusion" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="4"><CheckBox IsChecked="{Binding Included}" VerticalAlignment="Center" Click="InclusionChanged" AutomationProperties.Name="Include source in export" Margin="0,0,8,0"/><StackPanel><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="{DynamicResource MetadataSize}"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <WrapPanel Margin="0,6,0,0"><Button Style="{DynamicResource TertiaryButton}" Content="Add images…" Click="AddImages"/><Button Style="{DynamicResource TertiaryButton}" Content="Reload image" Click="ReloadImage"/></WrapPanel>
    </StackPanel></Expander>
    <Grid Grid.Row="1" x:Name="PreviewArea" Margin="16,0" ClipToBounds="True"><Image x:Name="PreviewImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"/><e:CropOverlay x:Name="CropHandles" Visibility="Collapsed" AutomationProperties.Name="Crop handles; arrow keys move crop, numeric fields resize"/><i:AnnotationOverlay x:Name="LayerHandles" Visibility="Collapsed" AutomationProperties.Name="Image layers; select, drag handles, arrow keys nudge, Delete removes"/></Grid>
    <StackPanel Grid.Row="2" Margin="12,8"><DockPanel><Button DockPanel.Dock="Right" Style="{DynamicResource TertiaryButton}" Content="Fit" Click="FitPreview"/><TextBlock x:Name="PreviewStatus" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" FontSize="{DynamicResource MetadataSize}"/></DockPanel><CheckBox x:Name="DetailPreview" Content="Inspect native output pixels" Click="DetailChanged" FontSize="{DynamicResource MetadataSize}"/></StackPanel>
   </Grid></Border>
   <Border Grid.Column="1" Background="{DynamicResource MaterialContentSurface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16"><ScrollViewer x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16"><StackPanel>
    <TextBlock Text="IMAGE TOOLS" FontSize="{DynamicResource MetadataSize}" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <ComboBox x:Name="ToolPicker" ItemsSource="{Binding Tools}" SelectionChanged="ToolChanged" AutomationProperties.Name="Image tool" Margin="0,0,0,12"/>
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Assertive"/>
    <StackPanel x:Name="Inspector"/>
    <Expander Header="Batch settings" Margin="0,16,0,8"><StackPanel>
     <TextBlock Text="Apply settings to included images" TextWrapping="Wrap" Margin="0,8"/>
     <ComboBox x:Name="MappingMode" SelectedIndex="0" Margin="0,8" AutomationProperties.Name="Batch crop mapping"><ComboBoxItem><TextBlock Text="Relative crop coordinates" TextWrapping="Wrap"/></ComboBoxItem><ComboBoxItem><TextBlock Text="Pixels (reject if crop does not fit)" TextWrapping="Wrap"/></ComboBoxItem></ComboBox>
     <Button Style="{DynamicResource SecondaryButton}" Content="Apply to all" Click="ApplyAll"/><TextBlock Text="Each image keeps its own layers, format and filename." TextWrapping="Wrap" Margin="0,10" FontSize="{DynamicResource MetadataSize}"/>
    </StackPanel></Expander>
    <Expander Header="Save location" Margin="0,8"><StackPanel><TextBlock x:Name="DestinationText" TextWrapping="Wrap" Margin="0,8" FontSize="{DynamicResource MetadataSize}"/><Button Style="{DynamicResource SecondaryButton}" Content="Choose folder…" Click="ChooseFolder"/></StackPanel></Expander>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Grid Grid.Row="2" Margin="4,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="IncludedText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="{DynamicResource MetadataSize}" Margin="0,0,12,0"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{DynamicResource SecondaryButton}" Content="Cancel" Click="Cancel" Margin="0,0,8,0"/><Button x:Name="ExportButton" Content="Create copies" Click="Export"/></StackPanel>
  </Grid>
 </Grid></p:MaterialSurface>
</Window>
