<Window x:Class="Citrus.Windows.Editors.EditorHostWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Citrus.Windows.Presentation" xmlns:e="clr-namespace:Citrus.Windows.Editors"
 Title="Image editor · Citrus" Width="1040" Height="720" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}" FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource BodySize}" TextBlock.LineHeight="{DynamicResource BodyLeading}">
 <p:MaterialSurface x:Name="Chrome"><Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto" MinHeight="72"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12"><TextBlock x:Name="Heading" FontSize="{DynamicResource EditorTitleSize}" FontWeight="SemiBold" TextWrapping="Wrap"/><WrapPanel Margin="0,8,0,0"><Button Style="{DynamicResource SecondaryButton}" Content="Undo" Click="Undo"/><Button Style="{DynamicResource SecondaryButton}" Content="Redo" Click="Redo"/><Button Style="{DynamicResource SecondaryButton}" Content="Reset" Click="Reset"/><Button Style="{DynamicResource SecondaryButton}" Content="Add images…" Click="AddImages"/><Button Style="{DynamicResource SecondaryButton}" Content="Reload image" Click="ReloadImage"/></WrapPanel></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="240"/><ColumnDefinition Width="304"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,12,0" Background="{DynamicResource MaterialContentSurface}"><Grid.RowDefinitions><RowDefinition Height="Auto" MaxHeight="145"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ListBox x:Name="SourceList" SelectionChanged="SelectSource" AutomationProperties.Name="Preview source; checkboxes control export inclusion" ScrollViewer.VerticalScrollBarVisibility="Auto">
     <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="4"><CheckBox IsChecked="{Binding Included}" VerticalAlignment="Center" Click="InclusionChanged" AutomationProperties.Name="Include source in export" Margin="0,0,8,0"/><StackPanel><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="{DynamicResource MetadataSize}"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="1" x:Name="PreviewArea" Margin="12" ClipToBounds="True"><Image x:Name="PreviewImage" Stretch="Uniform"/><e:CropOverlay x:Name="CropHandles" Visibility="Collapsed" AutomationProperties.Name="Crop handles; arrow keys move crop, numeric fields resize"/></Grid>
    <StackPanel Grid.Row="2" Margin="12"><TextBlock x:Name="PreviewStatus" TextWrapping="Wrap" FontSize="{DynamicResource MetadataSize}"/><CheckBox x:Name="DetailPreview" Content="Native output-pixel center detail (up to 512 × 512)" Click="DetailChanged"/></StackPanel>
   </Grid>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource MaterialContentSurface}" Padding="12"><StackPanel>
    <ComboBox x:Name="ToolPicker" ItemsSource="{Binding Tools}" SelectionChanged="ToolChanged" AutomationProperties.Name="Image tool" Margin="0,0,0,12"/>
    <StackPanel x:Name="Inspector"/>
    <Separator Margin="0,16"/><TextBlock Text="Apply settings to included images" TextWrapping="Wrap" FontWeight="SemiBold"/>
    <ComboBox x:Name="MappingMode" SelectedIndex="0" Margin="0,8" AutomationProperties.Name="Batch crop mapping"><ComboBoxItem><TextBlock Text="Relative crop coordinates" TextWrapping="Wrap"/></ComboBoxItem><ComboBoxItem><TextBlock Text="Pixels (reject if crop does not fit)" TextWrapping="Wrap"/></ComboBoxItem></ComboBox>
    <Button Style="{DynamicResource SecondaryButton}" Content="Apply to all" Click="ApplyAll"/><TextBlock Text="Each image keeps its own format and filename. Select a row to preview it; checkboxes choose the copies to create." TextWrapping="Wrap" Margin="0,10" FontSize="{DynamicResource MetadataSize}"/>
   </StackPanel></ScrollViewer>
  </Grid>
  <TextBlock Grid.Row="2" x:Name="ErrorText" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" Margin="0,8" AutomationProperties.LiveSetting="Assertive"/>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center"><TextBlock x:Name="DestinationText" TextWrapping="Wrap"/><WrapPanel><Button Style="{DynamicResource SecondaryButton}" Content="Choose folder…" Click="ChooseFolder"/><TextBlock x:Name="IncludedText" Margin="8"/></WrapPanel></StackPanel>
   <WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button Style="{DynamicResource SecondaryButton}" Content="Cancel" Click="Cancel" Margin="8,0"/><Button x:Name="ExportButton" Content="Create copies" Click="Export"/></WrapPanel>
  </Grid>
 </Grid></p:MaterialSurface>
</Window>
