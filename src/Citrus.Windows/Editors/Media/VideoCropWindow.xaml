<Window x:Class="Citrus.Windows.Editors.Media.VideoCropWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:p="clr-namespace:Citrus.Windows.Presentation" xmlns:e="clr-namespace:Citrus.Windows.Editors"
 Title="Crop Video · Citrus" Width="520" Height="500" MinWidth="400" MinHeight="360" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}" FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource BodySize}">
 <p:MaterialSurface x:Name="Chrome" CornerRadius="28"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
  <p:ChromeHeader MinHeight="52" VerticalContentAlignment="Center"><TextBlock Text="Crop Video" FontSize="18" FontWeight="SemiBold"/></p:ChromeHeader>
  <Grid x:Name="PreviewPane" Grid.Row="1" Height="244" Margin="18,8,18,0">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="PreviewArea" Background="#17191B" ClipToBounds="True">
     <Image x:Name="PreviewFrame" Stretch="Uniform" AutomationProperties.Name="Original video with interactive crop selection"/>
     <e:CropOverlay x:Name="CropHandles" VideoStyle="True" Visibility="Collapsed" AutomationProperties.Name="Crop selection. Drag handles to resize, drag inside to move; arrow keys nudge, Shift moves ten pixels"/>
     <TextBlock x:Name="LoadingText" Text="Preparing video…" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="280" Foreground="{DynamicResource SecondaryText}"/>
     <Border x:Name="PlaybackNoticeOverlay" Panel.ZIndex="10" IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="8" Padding="8,6"
       CornerRadius="7" MaxHeight="72" Background="{DynamicResource MaterialContentSurface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
      <TextBlock x:Name="PlaybackNotice" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52" FontSize="12"
       Foreground="{DynamicResource PrimaryText}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Text,RelativeSource={RelativeSource Self}}"/>
     </Border>
    </Grid>
   <StackPanel Grid.Row="1" IsEnabled="{Binding IsEnabled,ElementName=Controls}">
    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
      <Button x:Name="PlayButton" Style="{DynamicResource TertiaryButton}" MinHeight="28" Padding="8,5" Click="PlayPause" AutomationProperties.Name="Play video" ToolTip="Play or pause · Space">
       <Path x:Name="PlayGlyph" Data="M1,0 L9,5 1,10 Z" Fill="{DynamicResource PrimaryText}" Width="10" Height="10" Stretch="Uniform"/>
      </Button>
      <Button x:Name="PreviousFrameButton" Grid.Column="1" Style="{DynamicResource TertiaryButton}" MinHeight="28" Padding="8,5" Click="PreviousFrame" AutomationProperties.Name="Previous video frame" ToolTip="Previous frame"><Path Data="M9,0 L3,5 9,10 Z M1,0 L1,10" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.4" Width="10" Height="10" Stretch="Uniform"/></Button>
      <Slider x:Name="Timeline" Grid.Column="2" Margin="8,0,12,0" SmallChange="0.1" LargeChange="1" ValueChanged="TimelineChanged" PreviewMouseLeftButtonDown="ScrubStarted" PreviewMouseLeftButtonUp="ScrubReleased" PreviewKeyUp="SeekKeyReleased" AutomationProperties.Name="Video playback position in seconds"/>
      <Button x:Name="NextFrameButton" Grid.Column="3" Style="{DynamicResource TertiaryButton}" MinHeight="28" Padding="8,5" Click="NextFrame" AutomationProperties.Name="Next video frame" ToolTip="Next frame">
       <Path Data="M1,0 L7,5 1,10 Z M9,0 L9,10" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.4" Width="10" Height="10" Stretch="Uniform"/>
      </Button>
     </Grid>
     <DockPanel><TextBlock x:Name="DurationText" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource SecondaryText}"/><TextBlock x:Name="PositionText" FontSize="12" Foreground="{DynamicResource SecondaryText}"/></DockPanel>
   </StackPanel>
  </Grid>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource MaterialContentSurface}">
   <StackPanel x:Name="EditorBody" Margin="18,10,18,10">

    <StackPanel x:Name="Controls" IsEnabled="False" Grid.IsSharedSizeScope="True">
     <Grid Margin="0,12,0,10" HorizontalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Aspect ratio" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="110" TextWrapping="Wrap" FontSize="{DynamicResource SectionSize}" FontWeight="SemiBold"/>
      <ComboBox x:Name="AspectRatio" Grid.Column="1" SelectedIndex="0" SelectionChanged="RatioChanged" AutomationProperties.Name="Crop aspect ratio" Padding="10,3" MinHeight="28" MinWidth="168">
       <ComboBoxItem Content="Freeform"/><ComboBoxItem Content="Original"/><ComboBoxItem Content="1:1"/><ComboBoxItem Content="4:3"/><ComboBoxItem Content="3:2"/><ComboBoxItem Content="16:9"/><ComboBoxItem Content="9:16"/>
      </ComboBox>
     </Grid>
     <DockPanel Margin="0,0,0,6"><Button x:Name="ResetButton" DockPanel.Dock="Left" Content="Reset" Click="ResetCrop" MinHeight="28" Padding="10,3" Style="{DynamicResource SecondaryButton}" Background="{DynamicResource InsetBackground}" BorderBrush="Transparent" ToolTip="Reset crop · Ctrl+0; undo Ctrl+Z; redo Ctrl+Y"/>
      <TextBlock x:Name="Dimensions" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Medium" AutomationProperties.LiveSetting="Polite"/>
     </DockPanel>
     <Expander x:Name="MoreOptions" Header="More options" Margin="0,4,0,0"><StackPanel>
     <Grid x:Name="WidthRow" MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="60" SharedSizeGroup="CropCaption"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="52" SharedSizeGroup="CropValue"/></Grid.ColumnDefinitions>
      <TextBlock Text="Width" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <Slider x:Name="WidthSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" SmallChange="1" LargeChange="10" ValueChanged="WidthChanged" Margin="0,0,10,0" AutomationProperties.Name="Crop width percentage"/>
      <TextBox x:Name="WidthPercent" Grid.Column="2" Text="100%" TextAlignment="Right" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="3" MinHeight="28" KeyDown="PercentKeyDown" LostKeyboardFocus="PercentCommitted" AutomationProperties.Name="Crop width percent, 0 to 100"/>
     </Grid>
     <Grid x:Name="HeightRow" MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="60" SharedSizeGroup="CropCaption"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="52" SharedSizeGroup="CropValue"/></Grid.ColumnDefinitions>
      <TextBlock Text="Height" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <Slider x:Name="HeightSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" SmallChange="1" LargeChange="10" ValueChanged="HeightChanged" Margin="0,0,10,0" AutomationProperties.Name="Crop height percentage"/>
      <TextBox x:Name="HeightPercent" Grid.Column="2" Text="100%" TextAlignment="Right" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="3" MinHeight="28" KeyDown="PercentKeyDown" LostKeyboardFocus="PercentCommitted" AutomationProperties.Name="Crop height percent, 0 to 100"/>
     </Grid>
     </StackPanel></Expander>
    </StackPanel>
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0.7,0,0" Padding="20,12">
   <Button x:Name="ApplyButton" Content="Apply" Background="{DynamicResource ReferenceActionBackground}" Foreground="{DynamicResource ReferenceActionText}" IsEnabled="False" IsDefault="True" Click="ApplyCrop" HorizontalAlignment="Right" VerticalAlignment="Center" MinHeight="30" Padding="12,4" AutomationProperties.Name="Apply crop and create a new MP4 copy"/>
  </Border>
 </Grid></p:MaterialSurface>
</Window>
