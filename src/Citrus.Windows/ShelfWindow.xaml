<Window x:Class="Citrus.Windows.ShelfWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Citrus floating shelf" Width="420" Height="330" MinWidth="340" MinHeight="250" Topmost="True" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}">
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Top"><TextBlock Text="Floating shelf" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="References only. Select items and drag them to Explorer, or copy and paste with the keyboard." TextWrapping="Wrap" Margin="0,6,0,10"/></StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Copy selected" Click="CopySelected"/><Button Content="Remove references" Click="RemoveSelected" Margin="8,0,0,0" Style="{DynamicResource SecondaryButton}"/></StackPanel>
  <ListBox x:Name="References" SelectionMode="Extended" AutomationProperties.Name="Shelf file references" PreviewMouseLeftButtonDown="DragStarted" MouseMove="DragMoved" KeyDown="ShelfKeyDown"/>
 </DockPanel>
</Window>
