<Window x:Class="Citrus.Windows.ShelfWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Citrus.Windows.Presentation"
 Title="Citrus floating shelf" Width="420" Height="330" MinWidth="340" MinHeight="250" Topmost="True" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}" FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource BodySize}" TextBlock.LineHeight="{DynamicResource BodyLeading}">
 <p:MaterialSurface x:Name="Chrome">
 <ScrollViewer x:Name="ShelfScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="18">
   <TextBlock Text="Floating shelf" FontSize="{DynamicResource EditorTitleSize}" LineHeight="{DynamicResource EditorLeading}" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Text="References only. Select items and drag them to Explorer, or copy and paste with the keyboard." TextWrapping="Wrap" Margin="0,6,0,10"/>
   <ListBox x:Name="References" MinHeight="120" MaxHeight="240" SelectionMode="Extended" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Shelf file references" PreviewMouseLeftButtonDown="DragStarted" MouseMove="DragMoved" KeyDown="ShelfKeyDown">
    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <WrapPanel Margin="0,10,0,0">
    <Button x:Name="CopyReferences" Click="CopySelected" Margin="0,0,8,4"><TextBlock Text="Copy selected" TextWrapping="Wrap" TextAlignment="Center"/></Button>
    <Button x:Name="RemoveReferences" Click="RemoveSelected" Margin="0,0,0,4" Style="{DynamicResource SecondaryButton}"><TextBlock Text="Remove references" TextWrapping="Wrap" TextAlignment="Center"/></Button>
   </WrapPanel>
  </StackPanel>
 </ScrollViewer>
 </p:MaterialSurface>
</Window>
