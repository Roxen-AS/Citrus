<Window x:Class="Citrus.Windows.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Citrus.Windows.Presentation"
 Title="Citrus settings" Width="470" Height="560" MinWidth="420" MinHeight="480" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}" FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource BodySize}" TextBlock.LineHeight="{DynamicResource BodyLeading}">
 <p:MaterialSurface x:Name="Chrome">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="Error" TextWrapping="Wrap" Foreground="{DynamicResource ErrorText}" AutomationProperties.LiveSetting="Polite" Margin="0,10"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Click="Cancel" Style="{DynamicResource SecondaryButton}"/><Button Content="Save" Click="Save" IsDefault="True" Margin="8,0,0,0"/></StackPanel></StackPanel>
  <ScrollViewer Background="{DynamicResource MaterialContentSurface}" Padding="12" VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="Settings" FontSize="{DynamicResource TitleSize}" LineHeight="{DynamicResource TitleLeading}" FontWeight="SemiBold" Margin="0,0,0,14"/>
   <CheckBox x:Name="Startup" Margin="0,0,0,12"><TextBlock Text="Launch quietly at sign-in" TextWrapping="Wrap"/></CheckBox>
   <CheckBox x:Name="Sound" Margin="0,0,0,12"><TextBlock Text="Play quiet feedback sounds (uncheck to mute)" TextWrapping="Wrap"/></CheckBox>
   <CheckBox x:Name="Motion" Margin="0,0,0,12"><TextBlock Text="Reduce motion" TextWrapping="Wrap"/></CheckBox>
   <CheckBox x:Name="Transparency" Margin="0,0,0,12"><TextBlock Text="Reduce transparency" TextWrapping="Wrap"/></CheckBox>
   <CheckBox x:Name="Reveal" Margin="0,0,0,12"><TextBlock Text="Reveal completed outputs in Explorer" TextWrapping="Wrap"/></CheckBox>
   <Label Content="_Theme" Target="{Binding ElementName=Theme}"/><ComboBox x:Name="Theme" AutomationProperties.Name="Theme"/>
   <CheckBox x:Name="Gestures" Margin="0,18,0,10"><TextBlock Text="Enable drag gestures" TextWrapping="Wrap"/></CheckBox>
   <TextBlock Text="Assign each mode to a different key. Releasing a key keeps the wheel open." TextWrapping="Wrap"/>
   <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Label Content="_Shift" Target="{Binding ElementName=Shift}"/><ComboBox x:Name="Shift" Grid.Column="1" AutomationProperties.Name="Shift gesture mode"/>
    <Label Content="_Alt" Grid.Row="1" Target="{Binding ElementName=Alt}"/><ComboBox x:Name="Alt" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" AutomationProperties.Name="Alt gesture mode"/>
    <Label Content="_Control" Grid.Row="2" Target="{Binding ElementName=Control}"/><ComboBox x:Name="Control" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" AutomationProperties.Name="Control gesture mode"/>
   </Grid>
   <TextBlock Text="Windows high contrast, transparency and animation preferences take priority. Sound is controlled separately." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,18,0,0"/>
  </StackPanel></ScrollViewer>
 </DockPanel>
 </p:MaterialSurface>
</Window>
