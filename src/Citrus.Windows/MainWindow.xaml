<Window x:Class="Citrus.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Citrus" Width="710" Height="800" MinWidth="540" MinHeight="620" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><Image Source="{StaticResource CitrusMark}" Width="52" Height="52" Margin="0,0,14,0" DockPanel.Dock="Left"/><StackPanel><TextBlock Text="Citrus" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Local conversions. Fresh copies beside your originals." Foreground="{DynamicResource SecondaryText}"/></StackPanel></DockPanel>
    <StackPanel Grid.Row="1" Margin="0,15,0,12"><TextBlock Text="Drag in Explorer. Tap Shift for Convert or Alt for Tools." TextWrapping="Wrap"/><TextBlock Text="Release the key, glide to a choice, then drop. Esc or the center cancels." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/><TextBlock x:Name="EngineStatus" Text="Discovering installed engines…" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
    <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" CornerRadius="12" Padding="14" AllowDrop="True" PreviewDragOver="FilesDragOver" PreviewDrop="FilesDropped" AutomationProperties.Name="Drop local files here">
      <StackPanel>
        <DockPanel Margin="0,0,0,8"><Button Content="Add files…" Click="ChooseFiles" DockPanel.Dock="Right"/><TextBlock Text="Drop files here" FontSize="18" VerticalAlignment="Center"/></DockPanel>
        <ListBox x:Name="SelectedFiles" Height="92" SelectionMode="Extended" SelectionChanged="FileSelectionChanged" AutomationProperties.Name="Selected input files">
          <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" ToolTip="{Binding Path}"/></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Margin="0,8,0,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="RemoveButton" Content="Remove" Click="RemoveFiles" IsEnabled="False" Style="{DynamicResource SecondaryButton}" Padding="10,5"/><Button x:Name="ClearButton" Content="Clear" Click="ClearFiles" IsEnabled="False" Style="{DynamicResource SecondaryButton}" Padding="10,5"/></StackPanel><TextBlock x:Name="SelectionStatus" Text="Choose physical local files." VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/></DockPanel>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="3" Margin="0,12,0,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="Modes" SelectionChanged="ModeChanged" AutomationProperties.Name="Operation mode" Margin="0,0,8,0"><ComboBoxItem Content="Convert" IsSelected="True"/><ComboBoxItem Content="Tools"/></ComboBox>
        <ComboBox x:Name="Operations" Grid.Column="1" DisplayMemberPath="Label" SelectionChanged="OperationChanged" AutomationProperties.Name="Compatible operation"/>
        <Button x:Name="RunButton" Grid.Column="2" Content="Create copies" Click="RunOperation" IsEnabled="False" Margin="8,0,0,0"/>
      </Grid>
      <TextBlock x:Name="OperationHint" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,0"/>
      <TextBlock x:Name="Status" Text="Ready for your files." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
    <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock x:Name="JobSummary" Text="Jobs · no work submitted" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="JobList"><ItemsControl.ItemTemplate><DataTemplate>
        <Border Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="12" Margin="0,0,0,10"><StackPanel>
          <TextBlock Text="{Binding Source}" ToolTip="{Binding SourcePaths}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Operation}" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,5"/>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
          <ProgressBar Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" Height="5" Margin="0,8,0,8" AutomationProperties.Name="Conversion progress"/>
          <ItemsControl ItemsSource="{Binding Outputs}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,0,0,6"><Button Content="Reveal" Tag="{Binding Path}" Click="RevealOutput" DockPanel.Dock="Right" Padding="10,5" Margin="8,0,0,0" AutomationProperties.Name="Reveal output in Explorer"/><TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <StackPanel Orientation="Horizontal"><Button Content="Cancel" Tag="{Binding}" Click="CancelJob" IsEnabled="{Binding CanCancel}" Style="{DynamicResource SecondaryButton}" Padding="10,5"/><Button Content="Retry" Tag="{Binding}" Click="RetryJob" IsEnabled="{Binding CanRetry}" Style="{DynamicResource SecondaryButton}" Padding="10,5" Margin="6,0,0,0"/><Button Content="Choose folder…" Tag="{Binding}" Click="ChangeDestination" IsEnabled="{Binding CanChooseFolder}" Style="{DynamicResource SecondaryButton}" Padding="10,5" Margin="6,0,0,0"/></StackPanel>
        </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </Grid>
    <DockPanel Grid.Row="5" Margin="0,12,0,0"><CheckBox x:Name="GesturesEnabled" Content="Enable drag gestures" IsChecked="True" Checked="ToggleGestures" Unchecked="ToggleGestures"/><TextBlock Text="Windows candidate · offline" Foreground="{DynamicResource SecondaryText}" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
  </Grid>
</Window>
