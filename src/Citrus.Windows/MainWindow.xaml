<Window x:Class="Citrus.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Citrus · your file workspace" Width="1180" Height="820" MinWidth="860" MinHeight="640" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}" FontFamily="{DynamicResource AppFont}" FontSize="14" WindowStartupLocation="CenterScreen" SizeChanged="WorkspaceResized">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource PanelBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="16"/></Style>
  <Style x:Key="Metadata" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><Button Content="Try the wheel" Click="ShowDemo" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="Settings" Click="OpenSettings" Style="{DynamicResource SecondaryButton}"/></StackPanel><Image Source="{StaticResource CitrusMark}" Width="44" Height="44" Margin="0,0,12,0" DockPanel.Dock="Left"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Your file workspace" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Local processing. Fresh copies. Originals kept safe." Style="{StaticResource Metadata}"/></StackPanel></DockPanel>
  <Border Grid.Row="1" Background="{DynamicResource InsetBackground}" CornerRadius="12" Padding="12" Margin="0,8,0,16"><DockPanel><CheckBox x:Name="GesturesEnabled" Content="Drag gestures" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" IsChecked="True" Checked="ToggleGestures" Unchecked="ToggleGestures"/><StackPanel><TextBlock x:Name="GestureGuide" Text="Start dragging, then tap a key." TextWrapping="Wrap"/><TextBlock Text="Release the key, glide to a choice, then drop. Escape or the center cancels." Style="{StaticResource Metadata}" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid x:Name="WorkspaceGrid">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="FileColumn" Width="240"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InspectorColumn" Width="304"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.RowSpan="2" Style="{StaticResource Card}" Margin="0,0,16,0" AllowDrop="True" PreviewDragOver="FilesDragOver" PreviewDrop="FilesDropped" AutomationProperties.Name="Drop files and folders here">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="Your files" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Drop files here to get started" Style="{StaticResource Metadata}" Margin="0,6,0,12"/><Button Content="+ Add files" Click="ChooseFiles"/><Button Content="Add folder" Click="ChooseFolder" Style="{DynamicResource SecondaryButton}" Margin="0,8,0,12"/></StackPanel>
      <StackPanel Grid.Row="1"><TextBlock x:Name="SelectionStatus" Text="0 files included" FontWeight="SemiBold"/><WrapPanel Margin="0,4,0,8"><Button Content="Include all" Click="IncludeAll" Style="{DynamicResource SecondaryButton}" Padding="8,4"/><Button Content="Exclude all" Click="ExcludeAll" Style="{DynamicResource SecondaryButton}" Padding="8,4" Margin="4,0,0,0"/></WrapPanel></StackPanel>
      <ListBox x:Name="SelectedFiles" Grid.Row="2" MinHeight="120" MaxHeight="400" SelectionMode="Single" SelectionChanged="FileSelectionChanged" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource PrimaryText}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Preview a file; checkboxes choose batch inclusion">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource WorkspaceListItem}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="4,8"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><DockPanel><CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,8,0" AutomationProperties.Name="{Binding Name, StringFormat=Include {0} in batch}"/><TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="3"><TextBlock Text="Click to preview. Check to include." Style="{StaticResource Metadata}" Margin="0,12,0,8"/><WrapPanel><Button x:Name="RemoveButton" Content="Remove" Click="RemoveFiles" IsEnabled="False" Style="{DynamicResource SecondaryButton}" Padding="10,4"/><Button x:Name="ClearButton" Content="Clear list" Click="ClearFiles" IsEnabled="False" Style="{DynamicResource SecondaryButton}" Padding="10,4" Margin="4,0,0,0"/></WrapPanel></StackPanel>
     </Grid>
    </Border>
    <Grid x:Name="CenterPanel" Grid.Column="1" MinHeight="440" Margin="0,0,16,0">
     <Grid.RowDefinitions><RowDefinition Height="180"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}" Background="{DynamicResource InsetBackground}" Padding="12">
      <Grid><Image x:Name="PreviewImage" Stretch="Uniform" AutomationProperties.Name="Active file preview"/><StackPanel x:Name="PreviewFallback" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource Icon.File}" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.4" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock x:Name="PreviewMessage" Text="A little room for your next idea" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel><Border VerticalAlignment="Bottom" Background="{DynamicResource PanelBackground}" CornerRadius="8" Padding="8,4" Margin="0,4,0,0"><TextBlock x:Name="PreviewCaption" Text="Add a file to preview it here" TextTrimming="CharacterEllipsis" FontSize="12"/></Border></Grid>
     </Border>
     <ListBox x:Name="Modes" Grid.Row="1" ItemContainerStyle="{StaticResource WorkspaceListItem}" SelectionChanged="ModeChanged" SelectedIndex="0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource PrimaryText}" Margin="0,12,0,8" AutomationProperties.Name="Operation mode">
      <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBoxItem Padding="8,12" HorizontalContentAlignment="Center"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.Convert}" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.6" Margin="0,0,6,0"/><TextBlock Text="Convert"/></StackPanel></ListBoxItem>
      <ListBoxItem Padding="8,12" HorizontalContentAlignment="Center"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.Tools}" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.6" Margin="0,0,6,0"/><TextBlock Text="Tools"/></StackPanel></ListBoxItem>
      <ListBoxItem Padding="8,12" HorizontalContentAlignment="Center"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.Folder}" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.6" Margin="0,0,6,0"/><TextBlock Text="Files"/></StackPanel></ListBoxItem>
     </ListBox>
     <TextBlock x:Name="OperationsHeading" Grid.Row="2" Text="Choose an operation" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock x:Name="OperationsEmpty" Grid.Row="3" TextWrapping="Wrap" Style="{StaticResource Metadata}" Margin="0,0,0,8"/>
     <ListBox x:Name="Operations" Grid.Row="4" SelectionChanged="OperationChanged" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource PrimaryText}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="340" AutomationProperties.Name="Operations supported by all included files">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource WorkspaceListItem}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12"><DockPanel><Path Data="{Binding Icon}" Width="24" Height="24" Stretch="Uniform" Stroke="{DynamicResource ActionInk}" StrokeThickness="1.6" Margin="0,0,12,0"/><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" Style="{StaticResource Metadata}" Margin="0,4,0,0"/></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
    <Border x:Name="Inspector" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
     <StackPanel><TextBlock Text="Ready when you are" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="InspectorTitle" Text="Choose files and an operation" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,8"/><TextBlock x:Name="OperationHint" Style="{StaticResource Metadata}"/><Border Background="{DynamicResource InsetBackground}" CornerRadius="10" Padding="12" Margin="0,16,0,16"><StackPanel><TextBlock x:Name="BatchSummary" Text="0 included files" FontWeight="SemiBold"/><TextBlock x:Name="OutputSummary" Text="Copies saved beside each original" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock x:Name="SafetySummary" Text="Existing files are never replaced." Style="{StaticResource Metadata}" Margin="0,8,0,0"/></StackPanel></Border><Button x:Name="RunButton" Content="Create copies" Click="RunOperation" IsEnabled="False"/><TextBlock Text="Options and destination can be changed for tools and grouped outputs before starting." Style="{StaticResource Metadata}" Margin="0,12,0,0"/></StackPanel>
    </Border>
   </Grid>
  </ScrollViewer>
  <Expander x:Name="JobsPanel" Grid.Row="3" Margin="0,16,0,0" Foreground="{DynamicResource PrimaryText}" MaxHeight="230">
   <Expander.Header><TextBlock x:Name="JobSummary" Text="Jobs · results and recovery" FontWeight="SemiBold"/></Expander.Header>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><ItemsControl x:Name="SubmissionFailures"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,8,0,0"><DockPanel><Button Content="Retry" Tag="{Binding}" Click="RetrySubmission" IsEnabled="{Binding CanRetry}" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl x:Name="JobList"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Background="{DynamicResource PanelBackground}" CornerRadius="12" Padding="12" Margin="0,8,0,0"><StackPanel>
     <DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="Cancel" Tag="{Binding}" Click="CancelJob" IsEnabled="{Binding CanCancel}" Style="{DynamicResource SecondaryButton}" Padding="10,4"/><Button Content="Retry" Tag="{Binding}" Click="RetryJob" IsEnabled="{Binding CanRetry}" Style="{DynamicResource SecondaryButton}" Padding="10,4" Margin="6,0,0,0"/><Button Content="Save elsewhere…" Tag="{Binding}" Click="ChangeDestination" IsEnabled="{Binding CanChooseFolder}" Style="{DynamicResource SecondaryButton}" Padding="10,4" Margin="6,0,0,0"/></WrapPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Source}" ToolTip="{Binding SourcePaths}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Operation}" Style="{StaticResource Metadata}" Margin="0,4,0,0"/></StackPanel></DockPanel>
     <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/><ProgressBar Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" Height="5" Margin="0,8,0,8" AutomationProperties.Name="Conversion progress"/>
     <ItemsControl ItemsSource="{Binding Outputs}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,0,0,6"><Button Content="Reveal" Tag="{Binding Path}" Click="RevealOutput" DockPanel.Dock="Right" Padding="10,4" Margin="8,0,0,0" AutomationProperties.Name="Reveal output in Explorer"/><TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
  </Expander>
  <StackPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock x:Name="Status" Text="Add files to get started." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="EngineStatus" Text="Discovering installed engines…" Style="{StaticResource Metadata}" Margin="0,4,0,0"/></StackPanel>
 </Grid>
</Window>
