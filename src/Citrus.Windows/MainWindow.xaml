<Window x:Class="Citrus.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Citrus" Width="520" Height="580" MinWidth="460" MinHeight="540" Background="#202428" Foreground="#F3EFE9" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal"><Image Source="{StaticResource CitrusMark}" Width="54" Height="54" Margin="0,0,14,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Citrus" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="A fresh copy. Right beside your original." Foreground="#A8B0B7" FontSize="12"/></StackPanel></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,26,0,22"><TextBlock Text="Keep dragging. Tap Shift." FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Drag an image in Explorer, tap Shift, then glide to a format and release. Releasing Shift leaves the wheel open." TextWrapping="Wrap" Foreground="#C5CBD0" Margin="0,10,0,0"/><Border Background="#2E3439" CornerRadius="12" Padding="14" Margin="0,18,0,0"><StackPanel><TextBlock Text="SHIFT  Convert     ALT  Image tools" Foreground="#FFA65D" FontWeight="SemiBold"/><TextBlock Text="Drop in the center or press Esc to cancel." Foreground="#B5BDC4" Margin="0,7,0,0"/><TextBlock Text="Everything stays on your computer." Foreground="#B5BDC4" Margin="0,7,0,0"/></StackPanel></Border></StackPanel>
    <StackPanel Grid.Row="2"><TextBlock Text="Or choose an image with the keyboard" Margin="0,0,0,10"/><DockPanel><Button Content="Choose image…" Click="ChooseImage" DockPanel.Dock="Right" Margin="12,0,0,0"/><ComboBox x:Name="Formats" DisplayMemberPath="Label" VerticalContentAlignment="Center" AutomationProperties.Name="Output format" FontSize="13"/></DockPanel><TextBlock Text="Single-frame images only. Animated and multipage files are rejected. SVG converts to raster." TextWrapping="Wrap" Foreground="#A8B0B7" FontSize="11" Margin="0,10,0,0"/></StackPanel>
    <Border Grid.Row="3" Background="#282D32" CornerRadius="12" Padding="14" Margin="0,22,0,18"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Status" Text="Ready when you are. PNG, JPEG, WebP, TIFF, BMP, GIF and AVIF are available." TextWrapping="Wrap" Foreground="#C5CBD0"/></ScrollViewer></Border>
    <DockPanel Grid.Row="4"><CheckBox x:Name="GesturesEnabled" Content="Enable drag gestures" IsChecked="True" Foreground="#D4D9DD" VerticalAlignment="Center" Checked="ToggleGestures" Unchecked="ToggleGestures"/><TextBlock Text="Windows candidate" Foreground="#7F8992" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
  </Grid>
</Window>
