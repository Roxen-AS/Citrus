<Window x:Class="Citrus.Windows.WheelWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Citrus.Windows.Presentation"
 Title="Citrus wheel" Width="368" Height="414" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowActivated="False" ShowInTaskbar="False" Topmost="True" Focusable="False" FontFamily="{DynamicResource AppFont}">
 <Canvas x:Name="Surface" Background="#01000000" AllowDrop="True" Focusable="False">
  <Canvas x:Name="Presentation" Width="368" Height="414" IsHitTestVisible="False">
   <p:MaterialSurface x:Name="Shell" Role="WheelShell" Width="352" Height="352" Canvas.Left="8" Canvas.Top="8"/>
   <Ellipse Width="156" Height="156" Canvas.Left="106" Canvas.Top="106" Fill="{DynamicResource PanelBackground}"/>
   <Canvas x:Name="Sectors" Width="368" Height="368"/>
   <Border Canvas.Left="144" Canvas.Top="136" Width="80" Height="72" CornerRadius="12" Background="{DynamicResource PanelBackground}">
    <Grid><Path x:Name="FileGlyph" Data="{StaticResource Icon.File}" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.5" Width="34" Height="40" Stretch="Uniform" StrokeLineJoin="Round"/><Image x:Name="Preview" Width="72" Height="64" Stretch="Uniform"/></Grid>
   </Border>
   <Border x:Name="CountBadge" Canvas.Left="204" Canvas.Top="128" CornerRadius="10" Background="{DynamicResource Accent}" Padding="6,2"><TextBlock x:Name="CountLabel" Foreground="{DynamicResource AccentText}" FontSize="12" FontWeight="SemiBold"/></Border>
   <TextBlock x:Name="ModeLabel" Canvas.Left="122" Canvas.Top="215" Width="124" Text="CONVERT" Foreground="{DynamicResource ActionInk}" FontWeight="SemiBold" FontSize="10" TextAlignment="Center"/>
   <TextBlock x:Name="Badge" Canvas.Left="120" Canvas.Top="233" Width="128" Text="Drag a file here" Foreground="{DynamicResource SecondaryText}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
   <Border x:Name="CaptionPlate" Canvas.Left="62" Canvas.Top="364" Width="244" Height="46" CornerRadius="12" Padding="8,4" Background="{DynamicResource PanelBackground}">
    <Grid><Grid.RowDefinitions><RowDefinition x:Name="CaptionRow" Height="20"/><RowDefinition x:Name="HintRow" Height="16"/></Grid.RowDefinitions>
     <TextBlock x:Name="Caption" Text="Center to cancel" TextAlignment="Center" Foreground="{DynamicResource PrimaryText}" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     <TextBlock x:Name="Hint" Grid.Row="1" Margin="0,2,0,0" Text="Hold · glide · release" TextAlignment="Center" Foreground="{DynamicResource SecondaryText}" FontSize="11" LineHeight="14" LineStackingStrategy="BlockLineHeight"/>
    </Grid>
   </Border>
   <Border x:Name="Previous" Canvas.Left="18" Canvas.Top="370" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource PanelBackground}"><TextBlock Text="←" Foreground="{DynamicResource PrimaryText}" FontSize="22" HorizontalAlignment="Center"/></Border>
   <Border x:Name="Next" Canvas.Left="310" Canvas.Top="370" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource PanelBackground}"><TextBlock Text="→" Foreground="{DynamicResource PrimaryText}" FontSize="22" HorizontalAlignment="Center"/></Border>

  </Canvas>
 </Canvas>
</Window>
