<Window x:Class="Citrus.Windows.WheelWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Citrus.Windows.Presentation"
 Title="Citrus wheel" Width="368" Height="414" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowActivated="False" ShowInTaskbar="False" Topmost="True" Focusable="False" UseLayoutRounding="True" FontFamily="{DynamicResource AppFont}">
 <Canvas x:Name="Surface" Background="#01000000" AllowDrop="True" Focusable="False">
  <Canvas x:Name="Presentation" Width="368" Height="414" IsHitTestVisible="False">
   <p:MaterialSurface x:Name="Shell" Role="WheelShell" Width="352" Height="352" Canvas.Left="8" Canvas.Top="8"/>
   <Ellipse Width="156" Height="156" Canvas.Left="106" Canvas.Top="106" Fill="{DynamicResource WheelHubBackground}" Stroke="{DynamicResource WheelHubRim}" StrokeThickness="1"/>
   <Canvas x:Name="Sectors" Width="368" Height="368"/>
   <Border Canvas.Left="132" Canvas.Top="130" Width="104" Height="80" CornerRadius="12" Background="{DynamicResource InsetBackground}">
    <Grid><Grid.Clip><RectangleGeometry Rect="0,0,104,80" RadiusX="12" RadiusY="12"/></Grid.Clip><Path x:Name="FileGlyph" Data="{StaticResource Icon.File}" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.5" Width="30" Height="36" Stretch="Uniform" StrokeLineJoin="Round"/><Image x:Name="Preview" Width="104" Height="80" Stretch="UniformToFill"/></Grid>
   </Border>
   <Border x:Name="CountBadge" Canvas.Left="219" Canvas.Top="121" CornerRadius="10" Background="{DynamicResource Accent}" Padding="6,2"><TextBlock x:Name="CountLabel" Foreground="{DynamicResource AccentText}" FontSize="12" FontWeight="SemiBold"/></Border>
   <TextBlock x:Name="ModeLabel" ClipToBounds="True" Canvas.Left="154" Canvas.Top="237" Width="60" Height="16" LineHeight="16" LineStackingStrategy="BlockLineHeight" Text="CONVERT" Foreground="{DynamicResource SecondaryText}" FontWeight="SemiBold" FontSize="11" TextAlignment="Center"/>
   <TextBlock x:Name="Badge" ClipToBounds="True" Canvas.Left="128" Canvas.Top="214" Width="112" Height="20" LineHeight="20" LineStackingStrategy="BlockLineHeight" Text="Drag a file here" Foreground="{DynamicResource SecondaryText}" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
   <Border x:Name="CaptionPlate" Canvas.Left="62" Canvas.Top="364" Width="244" Height="46" CornerRadius="14" Padding="7,3" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Grid><Grid.RowDefinitions><RowDefinition x:Name="CaptionRow" Height="20"/><RowDefinition x:Name="HintRow" Height="18"/></Grid.RowDefinitions>
     <TextBlock x:Name="Caption" Text="Center to cancel" TextAlignment="Center" Foreground="{DynamicResource PrimaryText}" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     <TextBlock x:Name="Hint" Grid.Row="1" Margin="0,2,0,0" Text="Hold · glide · release" TextAlignment="Center" Foreground="{DynamicResource SecondaryText}" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight"/>
    </Grid>
   </Border>
   <Border x:Name="Previous" Canvas.Left="18" Canvas.Top="370" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Path Data="M 10,1 L 3,8 L 10,15" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.5" Width="14" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <Border x:Name="Next" Canvas.Left="310" Canvas.Top="370" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Path Data="M 3,1 L 10,8 L 3,15" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.5" Width="14" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>

  </Canvas>
 </Canvas>
</Window>
