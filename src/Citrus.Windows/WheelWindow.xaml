<Window x:Class="Citrus.Windows.WheelWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Citrus wheel" Width="336" Height="382" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowActivated="False" ShowInTaskbar="False" Topmost="True" Focusable="False">
  <Canvas x:Name="Surface" Background="#01000000" AllowDrop="True" Focusable="False">
    <Ellipse Width="308" Height="308" Canvas.Left="14" Canvas.Top="8" Fill="#F2222529" Stroke="#48504D" StrokeThickness="1" IsHitTestVisible="False"/>
    <Canvas x:Name="Sectors" Width="336" Height="324" IsHitTestVisible="False"/>
    <StackPanel Width="126" Canvas.Left="105" Canvas.Top="114" IsHitTestVisible="False">
      <Image Source="{StaticResource CitrusMark}" Width="36" Height="36"/>
      <TextBlock x:Name="ModeLabel" Text="CONVERT" Foreground="#F7A862" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
      <TextBlock x:Name="Badge" Text="Drag a file here" Foreground="#ECE8E2" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/>
      <TextBlock Text="center to cancel" Foreground="#8D949B" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0"/>
    </StackPanel>
    <Border x:Name="Previous" Canvas.Left="18" Canvas.Top="328" Width="56" Height="34" CornerRadius="10" Background="#F22A2E32" IsHitTestVisible="False"><TextBlock Text="←" Foreground="#FFC18C" FontSize="22" HorizontalAlignment="Center"/></Border>
    <Border x:Name="Next" Canvas.Left="262" Canvas.Top="328" Width="56" Height="34" CornerRadius="10" Background="#F22A2E32" IsHitTestVisible="False"><TextBlock Text="→" Foreground="#FFC18C" FontSize="22" HorizontalAlignment="Center"/></Border>
    <TextBlock x:Name="Hint" Width="180" Canvas.Left="78" Canvas.Top="332" Text="Hold · glide · release" TextAlignment="Center" Foreground="#CBD0D3" FontSize="11" IsHitTestVisible="False"/>
  </Canvas>
</Window>
