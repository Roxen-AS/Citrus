<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF owns startup/DPI; WinForms is used only for NotifyIcon. Manifest must precede every HWND. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources/Citrus.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Citrus.Conversion/Citrus.Conversion.csproj" />
    <Resource Include="Resources/Citrus.ico" />
    <Content Include="../../packaging/notices/Magick.NET-15.0.0-Notice.txt" Link="notices/Magick.NET-15.0.0-Notice.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireOfflineMediaForPublish" BeforeTargets="PrepareForPublish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Error Condition="!Exists('../../packaging/media/win-x64/ffmpeg.exe') Or !Exists('../../packaging/media/win-x64/ffprobe.exe') Or !Exists('../../packaging/media/source/citrus-media-source.tar.gz')" Text="Offline media assets or corresponding source archive are missing. Run packaging/build-media.sh before publishing." />
  </Target>
</Project>
