<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF owns startup/DPI; WinForms is used only for NotifyIcon. Manifest must precede every HWND. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources/Citrus.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Citrus.Conversion/Citrus.Conversion.csproj" />
    <Resource Include="Resources/Citrus.ico" />
    <Content Include="../../packaging/notices/Magick.NET-15.0.0-Notice.txt" Link="notices/Magick.NET-15.0.0-Notice.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
